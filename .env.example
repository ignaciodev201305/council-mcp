# Clave de OpenRouter (https://openrouter.ai/keys). Obligatoria.
OPENROUTER_API_KEY=tu-clave-de-openrouter
# Token que deben enviar los agentes de coding (mínimo 16 caracteres). Obligatorio.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
COUNCIL_TOKEN=genera-un-token-largo

# Opcionales (valores por defecto)
# COUNCIL_HOST=127.0.0.1
# COUNCIL_PORT=8765
# COUNCIL_MAX_CONCURRENT=4
# COUNCIL_DAILY_BUDGET_USD=1.0
# COUNCIL_MAX_SESSIONS=200
# COUNCIL_SESSION_TTL_DAYS=30
# COUNCIL_MEMBER_TIMEOUT_S=180
# COUNCIL_MODEL_TIMEOUT_S=120
# COUNCIL_SUMMARY_TRIGGER_TOKENS=6000
# COUNCIL_MAX_IDEA_CHARS=8000
# COUNCIL_MAX_CONTEXT_CHARS=30000

# Trazas en LangSmith (opcional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=tu-clave-de-langsmith
# LANGSMITH_AGENT_ID=tu-agent-id
# LANGSMITH_AGENT_ENVIRONMENT=local
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
